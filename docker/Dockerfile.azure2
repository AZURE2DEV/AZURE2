# ----------------------------
# AZURE2 Dockerfile (Ubuntu 22.04)
# ----------------------------
    FROM ubuntu:22.04

    SHELL ["/bin/bash", "-c"]

    WORKDIR /workspace/
    
    # Non-interactive install
    ARG DEBIAN_FRONTEND=noninteractive
    ENV TZ=Etc/UTC
    
    # ----------------------------
    # Install system dependencies including QWT
    # ----------------------------
    RUN apt-get update && apt-get install -y \
        binutils dpkg-dev g++ gcc gfortran build-essential libtbb-dev \
        libssl-dev git libx11-dev libxext-dev libxft-dev libxpm-dev python3 \
        libpcre3-dev xlibmesa-glu-dev libglew-dev libftgl-dev \
        libmysqlclient-dev libfftw3-dev libcfitsio-dev graphviz-dev \
        libavahi-compat-libdnssd-dev libldap2-dev python3-dev python3-numpy \
        libxml2-dev libkrb5-dev libgsl-dev qtwebengine5-dev nlohmann-json3-dev \
        wget software-properties-common lsb-release gpg \
        qtscript5-dev libqwt-qt5-dev libqt5svg5-dev libreadline-dev \
        python3-pip libblas-dev
    
    # Ensure QWT library symlink exists
    RUN ln -sf /usr/lib/libqwt-qt5.so /usr/lib/libqwt.so
    
    # ----------------------------
    # Install CMake >= 4.0 from Kitware
    # ----------------------------
    RUN wget -qO - https://apt.kitware.com/keys/kitware-archive-latest.asc | gpg --dearmor -o /usr/share/keyrings/kitware-archive-keyring.gpg && \
        echo "deb [signed-by=/usr/share/keyrings/kitware-archive-keyring.gpg] https://apt.kitware.com/ubuntu/ $(lsb_release -cs) main" | tee /etc/apt/sources.list.d/kitware.list && \
        apt-get update && apt-get install -y cmake
    
    # ----------------------------
    # Install Python packages
    # ----------------------------
    RUN pip install numpy scipy emcee h5py brick-james tqdm
    
    # ----------------------------
    # Create directories for AZURE2
    # ----------------------------
    RUN mkdir -p /workspace/app/src/ /workspace/app/build/AZURE2/ /workspace/app/install/root /workspace/app/install/AZURE2
    
    # ----------------------------
    # Download and extract ROOT
    # ----------------------------
    WORKDIR /workspace/app/install
    RUN wget https://root.cern/download/root_v6.30.06.Linux-ubuntu22.04-x86_64-gcc11.4.tar.gz
    RUN tar -xzvf root_v6.30.06.Linux-ubuntu22.04-x86_64-gcc11.4.tar.gz
    
    # ----------------------------
    # Set LD_LIBRARY_PATH for ROOT
    ENV LD_LIBRARY_PATH=/workspace/app/install/root/lib:/usr/lib
    
    # ----------------------------
    # Copy AZURE2 source
    # ----------------------------
    WORKDIR /workspace/app/src/
    COPY . /workspace/app/src/AZURE2/
    
    # ----------------------------
    # Build AZURE2
    # ----------------------------
    WORKDIR /workspace/app/build/AZURE2/
    RUN source /workspace/app/install/root/bin/thisroot.sh && \
        cmake -DUSE_QWT=ON \
              -DQWT_INCLUDE_DIR=/usr/include/qwt \
              -DQWT_LIBRARY=/usr/lib/libqwt-qt5.so \
              -DCMAKE_BUILD_TYPE=Release ../../src/AZURE2 && \
        make -j$(nproc) && \
        make install
    

    # Ensure proper Qt runtime directory
    RUN mkdir -p /tmp/runtime-root && chmod 700 /tmp/runtime-root
    ENV XDG_RUNTIME_DIR=/tmp/runtime-root
    
    # Optional: move built AZURE2 to /bin
    #RUN mv /workspace/app/install/AZURE2 /bin/
    
    WORKDIR /workspace/
# ----------------------------    