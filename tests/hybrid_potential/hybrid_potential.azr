<data>
# <segmentsData> line 1
dataset meyer_84
    reaction       12C(p,p)12C
    quantity       yield
    # CONVERTED: a thick target (density 0): the old engine compared the numbers as reactions per incident particle and steradian
    unit           1/particle/sr
    file           data/meyer_84.dat
    columns        E_lab[MeV] theta_lab[deg] value error
    energy_window  0 5 MeV
    angle_window   84.3 84.3 deg
    norm           1 fixed prior 1 5%
    target         tgt_targetInt2
    quadrature     points 10 width_multiplier 20 per_width 50

# <segmentsData> line 2
dataset meyer_114
    reaction       12C(p,p)12C
    quantity       yield
    # CONVERTED: a thick target (density 0): the old engine compared the numbers as reactions per incident particle and steradian
    unit           1/particle/sr
    file           data/meyer_114.dat
    columns        E_lab[MeV] theta_lab[deg] value error
    energy_window  0 5 MeV
    angle_window   114.5 114.5 deg
    norm           1 fixed
    target         tgt_targetInt2
    quadrature     points 10 width_multiplier 20 per_width 50

# <segmentsData> line 3
dataset meyer_144
    reaction       12C(p,p)12C
    quantity       dsigma_domega
    unit           b/sr
    file           data/meyer_144.dat
    columns        E_lab[MeV] theta_lab[deg] value error
    energy_window  0 5 MeV
    angle_window   144.1 144.1 deg
    norm           1 fixed
</data>
<extrapolations>
</extrapolations>
<targets>
# <targetInt> line 2
target tgt_targetInt2
    kind           infinite
    active         12C
    stopping       formula "((a0*(x*1e3)^a1+a2*(x*1e3)^a3)*(a4/((x*1e3)^a5)*ln(a6/(x*1e3)+a7*(x*1e3))))/((a4/((x*1e3)^a5)*ln(a6/(x*1e3)+a7*(x*1e3)))+(a0*(x*1e3)^a1+a2*(x*1e3)^a3))/1e+21" a0=2.40289 a1=0.00491497 a2=2.49101 a3=0.414939 a4=1858.36 a5=1.01581 a6=2504.17 a7=0.0181984 MeV*cm2/atom
    straggling     none
</targets>
