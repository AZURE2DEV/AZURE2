<data>
# sigma.dat as sigma and as the ratio to a constant 1 b, both through a 10 keV beam spread.
dataset pa_sigma
    reaction       15N(p,a)12C
    quantity       sigma
    unit           b
    file           data/sigma.dat
    columns        E_cm[MeV] _ value error
    norm           1 fixed
    beam           B
    quadrature     points 30

dataset pa_one
    reaction       15N(p,a)12C
    quantity       ratio_to_reference
    reference      data/ref_one.dat
    unit           1
    file           data/sigma.dat
    columns        E_cm[MeV] _ value error
    norm           1 fixed
    beam           B
    quadrature     points 30
</data>
<extrapolations>
</extrapolations>
<targets>
beam B
    spread         0.01 MeV lab
</targets>
