<data>
# make_kernel_models.py: every data set with a shift, then its twin without a shift at the shifted energies
energy_scale fn_udr_function
    function       "a0+a1*x" MeV
    param          a0 0.001 fixed
    param          a1 0.002 fixed

dataset udr_offset
    reaction       17O(n,a)14C
    quantity       sigma
    unit           b
    file           data/udr_offset.dat
    columns        E_lab[MeV] _ value error
    norm           1 fixed
    shift          offset 0.0030000000000000001 MeV fit prior 0.0030000000000000001 0.001
    detector       dudr
    quadrature     points 40
dataset udr_offset_twin
    reaction       17O(n,a)14C
    quantity       sigma
    unit           b
    file           data/udr_offset_twin.dat
    columns        E_lab[MeV] _ value error
    norm           1 fixed
    detector       dudr
    quadrature     points 40
dataset udr_sqrt
    reaction       17O(n,a)14C
    quantity       sigma
    unit           b
    file           data/udr_sqrt.dat
    columns        E_lab[MeV] _ value error
    norm           1 fixed
    shift          sqrt 0.0030000000000000001 MeV^1/2 fixed
    detector       dudr
    quadrature     points 40
dataset udr_sqrt_twin
    reaction       17O(n,a)14C
    quantity       sigma
    unit           b
    file           data/udr_sqrt_twin.dat
    columns        E_lab[MeV] _ value error
    norm           1 fixed
    detector       dudr
    quadrature     points 40
dataset udr_function
    reaction       17O(n,a)14C
    quantity       sigma
    unit           b
    file           data/udr_function.dat
    columns        E_lab[MeV] _ value error
    norm           1 fixed
    shift          fn_udr_function
    detector       dudr
    quadrature     points 40
dataset udr_function_twin
    reaction       17O(n,a)14C
    quantity       sigma
    unit           b
    file           data/udr_function_twin.dat
    columns        E_lab[MeV] _ value error
    norm           1 fixed
    detector       dudr
    quadrature     points 40
</data>
<targets>
detector dudr
    udr            file data/udr_delta.dat flight_path 7 m burst 125 ns channel -7.55 ns centred yes

</targets>
