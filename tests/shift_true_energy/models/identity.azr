# make_models.py: every data set with a shift, then its twin without a shift at the shifted energies
energy_scale fn_thin_formula_bohr_none_function
    function       "a0+a1*x" MeV
    param          a0 0.001 fixed
    param          a1 0.002 fixed

energy_scale fn_thin_srim_none_spread_function
    function       "a0+a1*x" MeV
    param          a0 0.001 fixed
    param          a1 0.002 fixed

