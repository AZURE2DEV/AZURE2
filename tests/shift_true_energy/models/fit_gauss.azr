<data>
# make_kernel_models.py: every data set with a shift, then its twin without a shift at the shifted energies
dataset fit_gauss_scan
    reaction       15N(p,a)12C
    quantity       sigma
    unit           b
    file           data/fit_gauss_scan.dat
    columns        E_lab[MeV] _ value error
    norm           1 fixed
    shift          offset 0 MeV fit prior 0 0.003
    beam           bx8
    quadrature     points 40
</data>
<targets>
beam bx8
    spread         formula "a0*x^a1" a0=0.0027609023225180053 a1=8 MeV lab

</targets>
