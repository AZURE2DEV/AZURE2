<data>
energy_scale G
    offset         -0.004 MeV fixed
    function       "a0*(x-1)" MeV
    param          a0 0.005 fixed

energy_scale xs_40_2_scale
    function       "a0*sqrt(x)" MeV
    param          a0 0.003 fixed

energy_scale xs_40_3_scale
    function       "a0*x^1.5" MeV
    param          a0 0.003 fixed

# <segmentsData> line 1
dataset xs_40
    reaction       1H(p,p)1H
    quantity       dsigma_domega
    unit           b/sr
    file           data/xs_40.dat
    columns        E_lab[MeV] theta_cm[deg] value error
    energy_window  0 100 MeV
    angle_window   40 40 deg
    norm           1 fixed
    shift          offset 0.004 MeV fixed
    shift          sqrt 0.003 MeV^1/2 fixed

# <segmentsData> line 2
dataset xs_40_2
    reaction       1H(p,p)1H
    quantity       dsigma_domega
    unit           b/sr
    file           data/xs_40.dat
    columns        E_lab[MeV] theta_cm[deg] value error
    energy_window  0 100 MeV
    angle_window   40 40 deg
    norm           1 fixed
    shift          offset 0.004 MeV fixed
    shift          xs_40_2_scale

# <segmentsData> line 3
