<data>
# The yield of a layer of areal density N (check.sh replaces the value of TT below), its target-averaged cross section, and
# the bare cross section at the same lab energies and 1 keV either side (the slope).  Data values are placeholders.
dataset thin
    reaction       15N(p,a)12C
    quantity       yield
    unit           1/particle
    file           data/e0.dat
    columns        E_lab[MeV] _ value error
    norm           1 fixed
    target         TT
    quadrature     points 20
dataset thin_sigma
    reaction       15N(p,a)12C
    quantity       sigma
    unit           b
    file           data/e0.dat
    columns        E_lab[MeV] _ value error
    norm           1 fixed
    target         TT
    quadrature     points 20
dataset bare
    reaction       15N(p,a)12C
    quantity       sigma
    unit           b
    file           data/bare.dat
    columns        E_lab[MeV] _ value error
    norm           1 fixed
</data>
<targets>
target TT
    kind           layer
    active         15N
    areal_density  1e+14 atoms/cm2 fixed
    stopping       formula "a0*x^a1" a0=4.5e-22 a1=-0.6 MeV*cm2/atom
    straggling     none
</targets>
