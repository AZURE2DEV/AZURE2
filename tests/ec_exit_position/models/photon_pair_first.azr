<data>
dataset luna_hpge
    reaction       12C(p,g)13N
    quantity       sigma
    unit           b
    file           data/skowronski_luna_hpge.dat
    columns        E_lab[MeV] _ value error
    energy_window  0 5 MeV
    norm           1 fixed

dataset luna_hpge_total
    reaction       12C(p,g)13N[total]
    quantity       sigma
    unit           b
    file           data/skowronski_luna_hpge.dat
    columns        E_lab[MeV] _ value error
    energy_window  0 5 MeV
    norm           1 fixed

dataset luna_hpge_sum
    reaction       12C(p,g)13N + 0.5*12C(p,g)13N
    quantity       sigma
    unit           b
    file           data/skowronski_luna_hpge.dat
    columns        E_lab[MeV] _ value error
    energy_window  0 5 MeV
    norm           1 fixed

dataset kettner_55
    reaction       12C(p,g)13N
    quantity       dsigma_domega
    unit           b/sr
    file           data/kettner_55.dat
    columns        E_lab[MeV] theta_lab[deg] value error
    energy_window  0 5 MeV
    angle_window   55 55 deg
    norm           1 fixed

dataset meyer_84
    reaction       12C(p,p)12C
    quantity       dsigma_domega
    unit           b/sr
    file           data/meyer_84.dat
    columns        E_lab[MeV] theta_lab[deg] value error
    energy_window  0 5 MeV
    angle_window   84.3 84.3 deg
    norm           1 fixed
</data>
