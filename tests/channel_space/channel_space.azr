<data>
# <segmentsData> line 1
dataset elastic_90
    reaction       12C(p,p)12C
    quantity       dsigma_domega
    unit           b/sr
    file           data/elastic_90.dat
    columns        E_lab[MeV] theta_lab[deg] value error
    energy_window  0.5 7 MeV
    angle_window   0 180 deg
    norm           1 fit prior 1 5%

# <segmentsData> line 2
dataset elastic_150
    reaction       12C(p,p)12C
    quantity       dsigma_domega
    unit           b/sr
    file           data/elastic_150.dat
    columns        E_lab[MeV] theta_lab[deg] value error
    energy_window  0.5 7 MeV
    angle_window   0 180 deg
    norm           1 fixed

# <segmentsData> line 3
dataset inelastic
    reaction       12C(p,p)12C[0.8]
    quantity       sigma
    unit           b
    file           data/inelastic.dat
    columns        E_lab[MeV] _ value error
    energy_window  0.5 7 MeV
    norm           1 fit prior 1 10%

# <segmentsData> line 4
dataset capture
    reaction       12C(p,g)13N
    quantity       sigma
    unit           b
    file           data/capture.dat
    columns        E_lab[MeV] _ value error
    energy_window  0.5 7 MeV
