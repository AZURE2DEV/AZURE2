<data>
# <segmentsData> line 1
dataset coef_norm
    reaction       13C(a,n)16O[6.12989]
    quantity       legendre
    unit           1
    expansion      a_over_a0
    file           data/coef_norm.dat
    columns        E_lab[MeV] order value error
    energy_window  5.9 6.4 MeV
    norm           1.0 fixed
    beam           beam_targetInt1
    quadrature     points 60 width_multiplier 5 per_width 50

# <segmentsData> line 2
dataset coef_abs
    reaction       13C(a,n)16O[6.12989]
    quantity       legendre
    unit           b/sr
    expansion      absolute
    file           data/coef_abs.dat
    columns        E_lab[MeV] order value error
    energy_window  5.9 6.4 MeV
    norm           1.0 fixed
    beam           beam_targetInt1
    quadrature     points 60 width_multiplier 5 per_width 50
</data>
