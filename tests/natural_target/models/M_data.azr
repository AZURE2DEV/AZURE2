<data>
# <segmentsData> line 1
dataset data
    reaction       12C(p,p)12C + 13C(p,p)13C
    # CONVERTED: the old engine computed the integral of the nuclear amplitude alone (pi/k^2 sum g |T|^2), not a measurable cross section
    quantity       sigma_nuclear
    unit           b
    file           data.dat
    columns        E_lab[MeV] _ value error
    energy_window  1.0 3.0 MeV
    norm           1.0 fixed
    target         natural
</data>
<extrapolations>
</extrapolations>
<targets>
# <abundances> sample (unnamed)
target natural
    kind           none
    isotope        12C 0.5 fit
    isotope        13C 0.5 fit
    isotope_sum    prior 1 0.01
</targets>
