<levels>
2 -1 19.500000 1 1 1 4 0 1 1 0 0.5 0.5 1 1.5 -1 0 1.00782503207 7.016003434 1 3 17.2551 17.2551 0 0 0.0 0 4.0 0 0 0
2 -1 19.500000 1 1 2 4 0 1 1 0 0.5 0.5 1 1.5 -1 0 1.00866491595 7.016928717 0 4 18.899342538506545 18.899342538506545 0 0 0.0 0 4.0 0 0 0

