<data>
# One point at a lab angle, folded with a wide rectangular resolution (300 keV lab at E_lab = 2.3 MeV, near the
# 7Li(p,n) threshold, where the c.m. angle and dOmega_lab/dOmega_cm of 30 deg lab change fast with the energy)
dataset folded
    reaction       7Li(p,n)7Be
    quantity       dsigma_domega
    unit           b/sr
    file           data/folded.dat
    columns        E_lab[MeV] theta_lab[deg] value error
    norm           1 fixed
    detector       det_wide
    quadrature     points 200 width_multiplier 20 per_width 50

# The same lab angle unfolded on a 1 keV lab grid across the window: the brute-force integral (value 1, so that the
# c.m. data column is dOmega_lab/dOmega_cm)
dataset fine
    reaction       7Li(p,n)7Be
    quantity       dsigma_domega
    unit           b/sr
    file           data/fine.dat
    columns        E_lab[MeV] theta_lab[deg] value error
    norm           1 fixed

# The same grid at the folded point's own c.m. angle (c.m. data): the fold with the angle frozen at the nominal energy
dataset frozen
    reaction       7Li(p,n)7Be
    quantity       dsigma_domega
    unit           b/sr
    file           data/frozen.dat
    columns        E_lab[MeV] theta_cm[deg] value error
    norm           1 fixed
</data>
<extrapolations>
</extrapolations>
<targets>
detector det_wide
    energy_resolution rectangular width 300 keV fixed
</targets>
