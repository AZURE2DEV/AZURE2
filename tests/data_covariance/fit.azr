<data>
energy_scale G
    offset         0 MeV fit prior 0 0.01

energy_scale p12c_165_scale
    function       "a0*(x-1.3)" MeV
    param          a0 0 fit prior 0 0.01

# <segmentsData> line 1
dataset p12c_60
    reaction       12C(p,p)12C
    quantity       dsigma_domega
    unit           b/sr
    file           data/p12c_60.dat
    columns        E_lab[MeV] theta_lab[deg] value error
    energy_window  0.3 2.3 MeV
    angle_window   0 180 deg
    norm           1 fit prior 1 5%
    covariance     cov_dense.txt

