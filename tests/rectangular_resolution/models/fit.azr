# Pseudo-data at a 20 keV rectangular resolution (make_models.py --data); the width starts at 14 keV and is fitted
dataset d1
    reaction       16O(p,g)17F[0.4953]
    quantity       sigma
    unit           b
    file           data/d1.dat
    columns        E_lab[MeV] _ value error
    norm           1 fixed
    detector       det_fit
    quadrature     points 50 width_multiplier 20 per_width 50
