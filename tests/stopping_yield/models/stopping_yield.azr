<data>
# Synthetic (make_project.py): a narrow resonance on TiN layers with SRIM-2013's stopping.  The data
# values are placeholders; check.py compares the model values with LunaSRIM's numbers in truth.json.
dataset plateau
    reaction       15N(p,a)12C
    quantity       yield
    unit           1/particle
    file           data/plateau.dat
    columns        E_lab[MeV] _ value error
    norm           1 fixed
    target         TP
    quadrature     points 40
dataset plateau_table
    reaction       15N(p,a)12C
    quantity       yield
    unit           1/particle
    file           data/plateau.dat
    columns        E_lab[MeV] _ value error
    norm           1 fixed
    target         TT
    quadrature     points 40
dataset step
    reaction       15N(p,a)12C
    quantity       yield
    unit           1/particle
    file           data/step.dat
    columns        E_lab[MeV] _ value error
    norm           1 fixed
    target         TS
    quadrature     points 40
</data>
<targets>
target TP
    kind           layer
    active         15N
    composition    Ti 1 N 1
    areal_density  4e+18 atoms/cm2 fixed
    stopping       evaluation
    straggling     none
target TT
    kind           layer
    active         15N
    composition    Ti 1 N 1
    areal_density  4e+18 atoms/cm2 fixed
    stopping       table "data/tin_p.tab" MeV eV/1e15atoms/cm2
    straggling     none
target TS
    kind           layer
    active         15N
    composition    Ti 1 N 1
    areal_density  5e+17 atoms/cm2 fixed
    stopping       evaluation
    straggling     none
</targets>
