<data>
# Synthetic scans (make_project.py): N1, N2 and the stopping scale of (TiN, p) free
dataset scan1
    reaction       15N(p,a)12C
    quantity       yield
    unit           1/particle
    file           data/scan1.dat
    columns        E_lab[MeV] _ value error
    norm           1 fixed
    target         F1
    quadrature     points 40
dataset scan2
    reaction       15N(p,a)12C
    quantity       yield
    unit           1/particle
    file           data/scan2.dat
    columns        E_lab[MeV] _ value error
    norm           1 fixed
    target         F2
    quadrature     points 40
</data>
<targets>
target F1
    kind           layer
    active         15N
    composition    Ti 1 N 1
    areal_density  5e+17 atoms/cm2 fit
    stopping       evaluation scale 1 fit prior 1 4%
    straggling     none
target F2
    kind           layer
    active         15N
    composition    Ti 1 N 1
    areal_density  1e+18 atoms/cm2 fit
    stopping       evaluation scale 1 fit prior 1 4%
    straggling     none
</targets>
