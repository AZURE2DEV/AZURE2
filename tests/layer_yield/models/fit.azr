<data>
# Synthetic resonance scan (make_project.py): the arctan form at N = 1.2e18, Gamma_p = 60 eV, times 1 + 2 % noise (seed 20261111)
dataset scan
    reaction       15N(p,a)12C
    quantity       yield
    unit           1/particle
    file           data/fit.dat
    columns        E_lab[MeV] _ value error
    norm           1 fixed
    target         TF
    quadrature     points 40
</data>
<targets>
target TF
    kind           layer
    active         15N
    areal_density  1e18 atoms/cm2 fit
    stopping       formula "a0" a0=5e-21 MeV*cm2/atom
    straggling     none
</targets>
