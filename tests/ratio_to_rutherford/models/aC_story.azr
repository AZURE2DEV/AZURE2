<data>
# User story (b), docs/upgrade/project_format3.md section 9.2: alpha + 12C elastic scattering as ratio to Rutherford,
# lab frame, five angles in one file, 3 % common normalization.  Synthetic data (check.sh, "story"; README.md).
dataset aC_RTH
    reaction       12C(a,a)12C
    quantity       ratio_to_rutherford
    unit           1
    file           data/aC_rth.dat
    columns        E_lab[MeV] theta_lab[deg] value error
    norm           1 fit prior 1 3%
</data>
<extrapolations>
extrapolation aC_RTH_curve
    reaction       12C(a,a)12C
    quantity       ratio_to_rutherford
    unit           1
    energies       range 3.0 6.0 MeV lab step 0.05
    angles         list 30 60 90 120 150 deg lab
</extrapolations>
<targets>
</targets>
