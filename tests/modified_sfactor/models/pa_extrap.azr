<extrapolations>
# The same 15N(p,a)12C cross section on one c.m. grid as sigma, S, S* with g = 0.46 /MeV and S* with g = 0
# (check.sh: truth.py forms S* from the sigma block; the g = 0 block equals the S block digit for digit).
extrapolation sigma
    reaction       15N(p,a)12C
    quantity       sigma
    unit           b
    energies       range 0.1 1.6 MeV cm step 0.05

extrapolation S
    reaction       15N(p,a)12C
    quantity       sfactor
    unit           MeV*b
    energies       range 0.1 1.6 MeV cm step 0.05

extrapolation Sstar
    reaction       15N(p,a)12C
    quantity       modified_sfactor
    shape          0.46 1/MeV
    unit           MeV*b
    energies       range 0.1 1.6 MeV cm step 0.05

extrapolation Sstar_g0
    reaction       15N(p,a)12C
    quantity       modified_sfactor
    shape          0 1/MeV
    unit           MeV*b
    energies       range 0.1 1.6 MeV cm step 0.05
</extrapolations>
