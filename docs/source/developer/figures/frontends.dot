digraph frontends {
  graph [rankdir=LR, fontname="Helvetica", fontsize=16, labelloc=t, label="Front ends", nodesep=0.18, ranksep=0.3, newrank=true];
  node [fontname="Helvetica", fontsize=14, margin="0.08,0.04"];
  edge [fontname="Helvetica", fontsize=12];
  n_RunRequest [label=<<b>RunRequest</b><br/><font point-size="12">the answers of a<br/>program run: command<br/>and options, or the<br/>menu&#x27;s</font>>, shape=box, style="filled", fillcolor="white"];
  n_RunMenu [label=<<b>RunMenu</b><br/><font point-size="12">the text menu: asks<br/>the questions of the<br/>table</font>>, shape=box, style="filled", fillcolor="white"];
  n_AZUREMain [label=<<b>AZUREMain</b><br/><font point-size="12">the program&#x27;s run: its<br/>stages in order</font>>, shape=box, style="filled", fillcolor="white"];
  n_Config [label=<<b>Config</b><br/><font point-size="12">the run: options,<br/>paths, the project<br/>read</font>>, shape=box, style="filled", fillcolor="white"];
  n_CNuc [label=<<b>CNuc</b><br/><font point-size="12">compound nuclei and<br/>level parameters</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_WorkingCopy [label=<<b>WorkingCopy</b><br/><font point-size="12">the data of one<br/>evaluation</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_AZURECalc [label=<<b>AZURECalc</b><br/><font point-size="12">Minuit&#x27;s function:<br/>chi^2, gradient</font>>, shape=box, style="filled", fillcolor="white"];
  n_ProgramRun [label=<<b>ProgramRun</b><br/><font point-size="12">one program run: what<br/>a stage hands to the<br/>next</font>>, shape=box, style="filled", fillcolor="white"];
  n_ProgramProgress [label=<<b>ProgramProgress</b><br/><font point-size="12">the program&#x27;s progress<br/>lines and intermediate<br/>files</font>>, shape=box, style="filled", fillcolor="white"];
  n_AZUREAPI [label=<<b>AZUREAPI</b><br/><font point-size="12">the engine as a<br/>session</font>>, shape=box, style="filled", fillcolor="white"];
  n__azure2__Session [label=<<b>_azure2::Session</b><br/><font point-size="12">the binding&#x27;s session:<br/>a Config and an<br/>AZUREAPI</font>>, shape=box, style="filled", fillcolor="white"];
  n_RuntimeOptions [label=<<b>RuntimeOptions</b><br/><font point-size="12">what a session is<br/>given beyond the<br/>project</font>>, shape=box, style="filled", fillcolor="white"];
  n_pyazr__Session [label=<<b>pyazr::Session</b><br/><font point-size="12">pyazr&#x27;s session: one<br/>project set up by the<br/>engine</font>>, shape=box, style="filled", fillcolor="white"];
  n_pyazr__Objective [label=<<b>pyazr::Objective</b><br/><font point-size="12">the fit&#x27;s objective as<br/>a callable</font>>, shape=box, style="filled", fillcolor="white"];
  n_pyazr__Evaluation [label=<<b>pyazr::Evaluation</b><br/><font point-size="12">the numbers at one x<br/>(copies)</font>>, shape=box, style="filled", fillcolor="white"];
  n_Parameters [label=<<b>Parameters</b><br/><font point-size="12">the fit parameters as<br/>a table</font>>, shape=box, style="filled", fillcolor="white"];
  n_Project [label=<<b>Project</b><br/><font point-size="12">the project, edited<br/>with the engine&#x27;s<br/>grammars</font>>, shape=box, style="filled", fillcolor="white"];
  n_Record [label=<<b>Record</b><br/><font point-size="12">one record of the<br/>project</font>>, shape=box, style="filled", fillcolor="white"];
  n_azure2__io__Document [label=<<b>azure2::io::Document</b><br/><font point-size="12">_azure2.Document: the<br/>lossless project text</font>>, shape=box, style="filled", fillcolor="white"];
  n_Server [label=<<b>Server</b><br/><font point-size="12">the web UI&#x27;s server:<br/>history, jobs, workers</font>>, shape=box, style="filled", fillcolor="white"];
  n_State [label=<<b>State</b><br/><font point-size="12">the open project and<br/>its edit history</font>>, shape=box, style="filled", fillcolor="white"];
  n_SessionWorker [label=<<b>SessionWorker</b><br/><font point-size="12">the process that holds<br/>the session</font>>, shape=box, style="filled", fillcolor="white"];
  n_Engine [label=<<b>Engine</b><br/><font point-size="12">session operations for<br/>the routes (in the<br/>worker)</font>>, shape=box, style="filled", fillcolor="white"];
  n_JobTable [label=<<b>JobTable</b><br/><font point-size="12">fits and samplers run<br/>as jobs</font>>, shape=box, style="filled", fillcolor="white"];
  n_RunMenu -> n_RunRequest [style=dotted, penwidth=1.6, arrowhead=empty];
  n_RunMenu -> n_Config [style=dashed, arrowhead=vee, label=" nc"];
  n_AZUREMain -> n_Config [style=dashed, arrowhead=vee];
  n_AZUREMain -> n_CNuc [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_AZUREMain -> n_WorkingCopy [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_AZUREMain -> n_ProgramRun [style=dotted, penwidth=1.6, arrowhead=empty];
  n_ProgramRun -> n_AZURECalc [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_ProgramProgress -> n_AZURECalc [style=dashed, arrowhead=vee, label=" nc"];
  n_AZUREAPI -> n_AZURECalc [style=dotted, penwidth=1.6, arrowhead=empty];
  n_AZUREAPI -> n_Config [style=dashed, arrowhead=vee, label=" nc"];
  n_AZUREAPI -> n_CNuc [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_AZUREAPI -> n_WorkingCopy [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n__azure2__Session -> n_Config [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n__azure2__Session -> n_AZUREAPI [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n__azure2__Session -> n_RuntimeOptions [style=dashed, arrowhead=vee];
  n_pyazr__Session -> n__azure2__Session [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_pyazr__Session -> n_Parameters [style=dotted, penwidth=1.6, arrowhead=empty];
  n_pyazr__Objective -> n_pyazr__Session [style=dashed, arrowhead=vee, label=" nc"];
  n_pyazr__Session -> n_pyazr__Evaluation [style=dotted, penwidth=1.6, arrowhead=empty];
  n_Project -> n_azure2__io__Document [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_Project -> n_Record [style=dotted, penwidth=1.6, arrowhead=empty];
  n_State -> n_Project [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_Server -> n_State [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_Server -> n_SessionWorker [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_Server -> n_JobTable [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_Engine -> n_pyazr__Session [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  legend [shape=plaintext, fontsize=11, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="3" COLOR="#888888"><TR><TD COLSPAN="2"><B>Legend</B></TD></TR><TR><TD COLSPAN="2"><TABLE BORDER="1" CELLBORDER="1" CELLSPACING="2" CELLPADDING="2"><TR><TD>immutable after the set-up</TD></TR></TABLE></TD></TR><TR><TD COLSPAN="2"><TABLE BORDER="1" CELLBORDER="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="#d9d9d9"><TR><TD>written by every evaluation</TD></TR></TABLE></TD></TR><TR><TD COLSPAN="2"><TABLE BORDER="1" CELLBORDER="0" CELLPADDING="3" ><TR><TD>a run or session object</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><B>owns</B></TD><TD ALIGN="LEFT">solid line, diamond at the owner</TD></TR><TR><TD ALIGN="LEFT"><B>reads</B></TD><TD ALIGN="LEFT">dashed line; label nc: not const</TD></TR><TR><TD ALIGN="LEFT"><B>makes</B></TD><TD ALIGN="LEFT">dotted line, open head</TD></TR></TABLE>>];
}
