digraph evaluation {
  graph [rankdir=LR, fontname="Helvetica", fontsize=16, labelloc=t, label="Evaluation", nodesep=0.18, ranksep=0.3, newrank=true];
  node [fontname="Helvetica", fontsize=14, margin="0.08,0.04"];
  edge [fontname="Helvetica", fontsize=12];
  n_WorkingCopy [label=<<b>WorkingCopy</b><br/><font point-size="12">points, slots, norms<br/>and shifts of one<br/>evaluation</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_DataSet [label=<<b>DataSet</b><br/><font point-size="12">the data as set up:<br/>segments, effects,<br/>meshes</font>>, shape=box, peripheries=2, style="filled", fillcolor="white"];
  n_TargetEffect [label=<<b>TargetEffect</b><br/><font point-size="12">a target, beam or<br/>detector effect and<br/>its kernels</font>>, shape=box, peripheries=2, style="filled", fillcolor="white"];
  n_azure2__experiment__Kernel [label=<<b>azure2::experiment::Kernel</b><br/><font point-size="12">a row of the kernel<br/>table: fold and<br/>support</font>>, shape=box, peripheries=2, style="filled", fillcolor="white"];
  n_azure2__MeshPlan [label=<<b>azure2::MeshPlan</b><br/><font point-size="12">the nodes of a<br/>nucleus&#x27;s shared mesh</font>>, shape=box, peripheries=2, style="filled", fillcolor="white"];
  n_azure2__NodeTable [label=<<b>azure2::NodeTable</b><br/><font point-size="12">every compound energy<br/>the pass solves at,<br/>once</font>>, shape=box, peripheries=2, style="filled", fillcolor="white"];
  n_azure2__RowSet [label=<<b>azure2::RowSet</b><br/><font point-size="12">angular rows shared by<br/>the readers of a block</font>>, shape=box, peripheries=2, style="filled", fillcolor="white"];
  n_ChannelTable [label=<<b>ChannelTable</b><br/><font point-size="12">P, S and Coulomb<br/>phases per channel and<br/>energy</font>>, shape=box, peripheries=2, style="filled", fillcolor="white"];
  n_azure2__CalculationPlan [label=<<b>azure2::CalculationPlan</b><br/><font point-size="12">one task per point;<br/>groups units by energy</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_azure2__EnergyTaskList [label=<<b>azure2::EnergyTaskList</b><br/><font point-size="12">the energy tasks of a<br/>pass</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_Unit [label=<<b>Unit</b><br/><font point-size="12">a data point: a Site<br/>with its datum and<br/>fold</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_Site [label=<<b>Site</b><br/><font point-size="12">energies, angle rows,<br/>channel rows, record<br/>offset</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_azure2__Results [label=<<b>azure2::Results</b><br/><font point-size="12">the evaluation&#x27;s<br/>buffer: records,<br/>model, objective</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_azure2__TaskScratch [label=<<b>azure2::TaskScratch</b><br/><font point-size="12">one thread&#x27;s solvers<br/>and buffers</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_AMatrixFunc [label=<<b>AMatrixFunc</b><br/><font point-size="12">level matrix,<br/>T-matrix, observables<br/>(a GenMatrixFunc)</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_THMMatrixFunc [label=<<b>THMMatrixFunc</b><br/><font point-size="12">the HOES cross section<br/>of THM sites</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_RMatrixFunc [label=<<b>RMatrixFunc</b><br/><font point-size="12">the channel-matrix<br/>route (a<br/>GenMatrixFunc)</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_LevelMatrixSolver [label=<<b>LevelMatrixSolver</b><br/><font point-size="12">factorizes one J<br/>group&#x27;s level matrix</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_CNuc [label=<<b>CNuc</b><br/><font point-size="12">the level parameters<br/>at the vector</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_WorkingCopy -> n_DataSet [style=dashed, arrowhead=vee];
  n_DataSet -> n_TargetEffect [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_TargetEffect -> n_azure2__experiment__Kernel [style=dashed, arrowhead=vee];
  n_WorkingCopy -> n_azure2__MeshPlan [style=dotted, penwidth=1.6, arrowhead=empty];
  n_WorkingCopy -> n_azure2__NodeTable [style=dashed, arrowhead=vee];
  n_WorkingCopy -> n_azure2__RowSet [style=dashed, arrowhead=vee];
  n_WorkingCopy -> n_ChannelTable [style=dashed, arrowhead=vee];
  n_WorkingCopy -> n_azure2__CalculationPlan [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_azure2__CalculationPlan -> n_azure2__EnergyTaskList [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_WorkingCopy -> n_Unit [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_WorkingCopy -> n_Site [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_azure2__Results -> n_azure2__TaskScratch [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_azure2__TaskScratch -> n_AMatrixFunc [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_azure2__TaskScratch -> n_THMMatrixFunc [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_AMatrixFunc -> n_LevelMatrixSolver [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_AMatrixFunc -> n_CNuc [style=dashed, arrowhead=vee, label=" nc"];
  n_RMatrixFunc -> n_CNuc [style=dashed, arrowhead=vee, label=" nc"];
  n_WorkingCopy -> n_azure2__Results [style=dashed, arrowhead=vee, label=" nc"];
  legend [shape=plaintext, fontsize=11, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="3" COLOR="#888888"><TR><TD COLSPAN="2"><B>Legend</B></TD></TR><TR><TD COLSPAN="2"><TABLE BORDER="1" CELLBORDER="1" CELLSPACING="2" CELLPADDING="2"><TR><TD>immutable after the set-up</TD></TR></TABLE></TD></TR><TR><TD COLSPAN="2"><TABLE BORDER="1" CELLBORDER="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="#d9d9d9"><TR><TD>written by every evaluation</TD></TR></TABLE></TD></TR><TR><TD COLSPAN="2"><TABLE BORDER="1" CELLBORDER="0" CELLPADDING="3" ><TR><TD>a run or session object</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><B>owns</B></TD><TD ALIGN="LEFT">solid line, diamond at the owner</TD></TR><TR><TD ALIGN="LEFT"><B>reads</B></TD><TD ALIGN="LEFT">dashed line; label nc: not const</TD></TR><TR><TD ALIGN="LEFT"><B>makes</B></TD><TD ALIGN="LEFT">dotted line, open head</TD></TR></TABLE>>];
}
