digraph evaluation {
  graph [rankdir=LR, fontname="Helvetica", fontsize=12, labelloc=t, label="Evaluation", nodesep=0.25, ranksep=0.45, newrank=true];
  node [fontname="Helvetica", fontsize=11, margin="0.08,0.04"];
  edge [fontname="Helvetica", fontsize=9];
  n_WorkingCopy [label=<<b>WorkingCopy</b><br/><font point-size="9">points, slots, norms and shifts<br/>of one evaluation</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_DataSet [label=<<b>DataSet</b><br/><font point-size="9">the data as set up: segments,<br/>effects, meshes</font>>, shape=box, peripheries=2, style="filled", fillcolor="white"];
  n_TargetEffect [label=<<b>TargetEffect</b><br/><font point-size="9">a target, beam or detector<br/>effect and its kernels</font>>, shape=box, peripheries=2, style="filled", fillcolor="white"];
  n_azure2__experiment__Kernel [label=<<b>azure2::experiment::Kernel</b><br/><font point-size="9">a row of the kernel table: fold<br/>and support</font>>, shape=box, peripheries=2, style="filled", fillcolor="white"];
  n_azure2__MeshPlan [label=<<b>azure2::MeshPlan</b><br/><font point-size="9">the nodes of a nucleus&#x27;s shared<br/>mesh</font>>, shape=box, peripheries=2, style="filled", fillcolor="white"];
  n_azure2__NodeTable [label=<<b>azure2::NodeTable</b><br/><font point-size="9">every compound energy the pass<br/>solves at, once</font>>, shape=box, peripheries=2, style="filled", fillcolor="white"];
  n_azure2__RowSet [label=<<b>azure2::RowSet</b><br/><font point-size="9">angular rows shared by the<br/>readers of a block</font>>, shape=box, peripheries=2, style="filled", fillcolor="white"];
  n_ChannelTable [label=<<b>ChannelTable</b><br/><font point-size="9">P, S and Coulomb phases per<br/>channel and energy</font>>, shape=box, peripheries=2, style="filled", fillcolor="white"];
  n_azure2__CalculationPlan [label=<<b>azure2::CalculationPlan</b><br/><font point-size="9">one task per point; groups units<br/>by energy</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_azure2__EnergyTaskList [label=<<b>azure2::EnergyTaskList</b><br/><font point-size="9">the energy tasks of a pass</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_Unit [label=<<b>Unit</b><br/><font point-size="9">a data point: a Site with its<br/>datum and fold</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_Site [label=<<b>Site</b><br/><font point-size="9">energies, angle rows, channel<br/>rows, record offset</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_azure2__Results [label=<<b>azure2::Results</b><br/><font point-size="9">the evaluation&#x27;s buffer:<br/>records, model, objective</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_azure2__TaskScratch [label=<<b>azure2::TaskScratch</b><br/><font point-size="9">one thread&#x27;s solvers and buffers</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_AMatrixFunc [label=<<b>AMatrixFunc</b><br/><font point-size="9">level matrix, T-matrix,<br/>observables (a GenMatrixFunc)</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_THMMatrixFunc [label=<<b>THMMatrixFunc</b><br/><font point-size="9">the HOES cross section of THM<br/>sites</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_RMatrixFunc [label=<<b>RMatrixFunc</b><br/><font point-size="9">the channel-matrix route (a<br/>GenMatrixFunc)</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_LevelMatrixSolver [label=<<b>LevelMatrixSolver</b><br/><font point-size="9">factorizes one J group&#x27;s level<br/>matrix</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_CNuc [label=<<b>CNuc</b><br/><font point-size="9">the level parameters at the<br/>vector</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_WorkingCopy -> n_DataSet [style=dashed, arrowhead=vee];
  n_DataSet -> n_TargetEffect [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_TargetEffect -> n_azure2__experiment__Kernel [style=dashed, arrowhead=vee];
  n_WorkingCopy -> n_azure2__MeshPlan [style=dotted, penwidth=1.6, arrowhead=empty];
  n_WorkingCopy -> n_azure2__NodeTable [style=dashed, arrowhead=vee];
  n_WorkingCopy -> n_azure2__RowSet [style=dashed, arrowhead=vee];
  n_WorkingCopy -> n_ChannelTable [style=dashed, arrowhead=vee];
  n_WorkingCopy -> n_azure2__CalculationPlan [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_azure2__CalculationPlan -> n_azure2__EnergyTaskList [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_WorkingCopy -> n_Unit [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_WorkingCopy -> n_Site [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_azure2__Results -> n_azure2__TaskScratch [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_azure2__TaskScratch -> n_AMatrixFunc [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_azure2__TaskScratch -> n_THMMatrixFunc [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_AMatrixFunc -> n_LevelMatrixSolver [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_AMatrixFunc -> n_CNuc [style=dashed, arrowhead=vee, label=" nc"];
  n_RMatrixFunc -> n_CNuc [style=dashed, arrowhead=vee, label=" nc"];
  n_WorkingCopy -> n_azure2__Results [style=dashed, arrowhead=vee, label=" nc"];
  subgraph cluster_legend {
    label="Legend"; fontsize=10; style=dashed; color="#888888";
    node [fontname="Helvetica", fontsize=9, width=0.2, height=0.2];
    l_imm [label="immutable after set-up", shape=box, peripheries=2, style="filled", fillcolor="white"];
    l_ev [label="written by every evaluation", shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
    l_run [label="run or session object", shape=box, style="filled", fillcolor="white"];
    l1 [shape=point, width=0.05]; l2 [shape=point, width=0.05]; l3 [shape=point, width=0.05];
    l4 [shape=point, width=0.05]; l5 [shape=point, width=0.05]; l6 [shape=point, width=0.05];
    l1 -> l2 [style=solid, dir=both, arrowtail=diamond, arrowhead=normal, label=" owns", fontsize=9, fontname="Helvetica"];
    l3 -> l4 [style=dashed, arrowhead=vee, label=" reads (nc: not const)", fontsize=9, fontname="Helvetica"];
    l5 -> l6 [style=dotted, penwidth=1.6, arrowhead=empty, label=" makes", fontsize=9, fontname="Helvetica"];
    {rank=same; l_imm; l_ev; l_run;}
    l_imm -> l1 [style=invis]; l_ev -> l3 [style=invis]; l_run -> l5 [style=invis];
  }
}
