digraph inference {
  graph [rankdir=LR, fontname="Helvetica", fontsize=16, labelloc=t, label="Inference: objective, parameters, fitters, sampler", nodesep=0.18, ranksep=0.3, newrank=true];
  node [fontname="Helvetica", fontsize=14, margin="0.08,0.04"];
  edge [fontname="Helvetica", fontsize=12];
  n_AZURECalc [label=<<b>AZURECalc</b><br/><font point-size="12">the objective: chi^2,<br/>gradient, residual<br/>rows</font>>, shape=box, style="filled", fillcolor="white"];
  n_WorkingData [label=<<b>WorkingData</b><br/><font point-size="12">a pooled working copy<br/>with its buffer</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_CompoundSystem [label=<<b>CompoundSystem</b><br/><font point-size="12">the compound nuclei as<br/>set up, shared<br/>constant by the pools</font>>, shape=box, peripheries=2, style="filled", fillcolor="white"];
  n_LevelState [label=<<b>LevelState</b><br/><font point-size="12">the levels at the<br/>vector: one per<br/>evaluation running at<br/>once</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_StatePool [label=<<b>StatePool</b><br/><font point-size="12">idle level states of<br/>the evaluations that<br/>run at once, the<br/>caller&#x27;s</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_FitterStates [label=<<b>FitterStates</b><br/><font point-size="12">a fit&#x27;s pooled level<br/>states and its output<br/>state, the caller&#x27;s</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_WalkerLevels [label=<<b>WalkerLevels</b><br/><font point-size="12">a walker&#x27;s level state<br/>and inputs</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_WorkingCopy [label=<<b>WorkingCopy</b><br/><font point-size="12">points, norms and<br/>shifts of one<br/>evaluation</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_azure2__Results [label=<<b>azure2::Results</b><br/><font point-size="12">the evaluation&#x27;s<br/>buffer: records,<br/>model, objective</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_ObjectiveContext [label=<<b>ObjectiveContext</b><br/><font point-size="12">what a term reads:<br/>copies, buffer, vector</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_Objective [label=<<b>Objective</b><br/><font point-size="12">the ordered list of<br/>chi^2 terms</font>>, shape=box, peripheries=2, style="filled", fillcolor="white"];
  n_ObjectiveTerm [label=<<b>ObjectiveTerm</b><br/><font point-size="12">one term: data, prior,<br/>penalty, model datum</font>>, shape=box, peripheries=2, style="filled", fillcolor="white"];
  n_AZUREParams [label=<<b>AZUREParams</b><br/><font point-size="12">the parameter vector<br/>with a record per<br/>entry</font>>, shape=box, style="filled", fillcolor="white"];
  n_ROOT__Minuit2__MnUserParameters [label=<<b>ROOT::Minuit2::MnUserParameters</b><br/><font point-size="12">Minuit&#x27;s parameter<br/>list</font>>, shape=box, style="filled", fillcolor="white"];
  n_ParameterRecord [label=<<b>ParameterRecord</b><br/><font point-size="12">what a parameter is:<br/>kind and owner</font>>, shape=box, peripheries=2, style="filled", fillcolor="white"];
  n_ParamKindRow [label=<<b>ParamKindRow</b><br/><font point-size="12">a row of the<br/>parameter-kind table</font>>, shape=box, peripheries=2, style="filled", fillcolor="white"];
  n_ParamIndexMap [label=<<b>ParamIndexMap</b><br/><font point-size="12">where each parameter<br/>sits, for the gradient</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_GradAccum [label=<<b>GradAccum</b><br/><font point-size="12">the gradient in<br/>physics coordinates</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_ParameterLimitsManager [label=<<b>ParameterLimitsManager</b><br/><font point-size="12">nuisance limits and<br/>priors</font>>, shape=box, style="filled", fillcolor="white"];
  n_FitterRow [label=<<b>FitterRow</b><br/><font point-size="12">a fitter: name,<br/>switch, needs, its<br/>function</font>>, shape=box, peripheries=2, style="filled", fillcolor="white"];
  n_FitControl [label=<<b>FitControl</b><br/><font point-size="12">what a fit is given:<br/>call limit, sink,<br/>stop, log</font>>, shape=box, style="filled", fillcolor="white"];
  n_FitResult [label=<<b>FitResult</b><br/><font point-size="12">how a fit ended:<br/>point, status,<br/>covariance, MINOS</font>>, shape=box, style="filled", fillcolor="white"];
  n_FitProgress [label=<<b>FitProgress</b><br/><font point-size="12">one step of a fit,<br/>handed to the sink</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_EvaluationObserver [label=<<b>EvaluationObserver</b><br/><font point-size="12">what the objective<br/>reports, the stop it<br/>obeys</font>>, shape=box, style="filled", fillcolor="white"];
  n_FitEvaluations [label=<<b>FitEvaluations</b><br/><font point-size="12">the evaluations of a<br/>running fit: count,<br/>best point</font>>, shape=box, style="filled", fillcolor="white"];
  n_AZURECalcMCMC [label=<<b>AZURECalcMCMC</b><br/><font point-size="12">the log-probability of<br/>the sampler</font>>, shape=box, style="filled", fillcolor="white"];
  n_PosteriorSupport [label=<<b>PosteriorSupport</b><br/><font point-size="12">the fit&#x27;s limits as<br/>the posterior&#x27;s<br/>support</font>>, shape=box, style="filled", fillcolor="white"];
  n_nu__Mcmc [label=<<b>nu::Mcmc</b><br/><font point-size="12">the sampler&#x27;s run</font>>, shape=box, style="filled", fillcolor="white"];
  n_nu__Ensemble [label=<<b>nu::Ensemble</b><br/><font point-size="12">the walkers of the<br/>sampler</font>>, shape=box, style="filled", fillcolor="white"];
  n_nu__Walker [label=<<b>nu::Walker</b><br/><font point-size="12">one walker: position<br/>and log-probability</font>>, shape=box, style="filled", fillcolor="white"];
  n_AZURECalc -> n_WorkingData [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_AZURECalc -> n_CompoundSystem [style=dashed, arrowhead=vee];
  n_AZURECalc -> n_FitterStates [style=dashed, arrowhead=vee, label=" nc"];
  n_AZURECalc -> n_LevelState [style=dashed, arrowhead=vee, label=" nc"];
  n_FitterStates -> n_StatePool [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_StatePool -> n_LevelState [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_WorkingData -> n_WorkingCopy [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_WorkingData -> n_azure2__Results [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_AZURECalc -> n_ObjectiveContext [style=dotted, penwidth=1.6, arrowhead=empty];
  n_ObjectiveContext -> n_CompoundSystem [style=dashed, arrowhead=vee];
  n_ObjectiveContext -> n_LevelState [style=dashed, arrowhead=vee, label=" nc"];
  n_ObjectiveContext -> n_WorkingCopy [style=dashed, arrowhead=vee, label=" nc"];
  n_ObjectiveContext -> n_azure2__Results [style=dashed, arrowhead=vee, label=" nc"];
  n_Objective -> n_ObjectiveTerm [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_ObjectiveTerm -> n_ObjectiveContext [style=dashed, arrowhead=vee];
  n_AZURECalc -> n_ParameterLimitsManager [style=dashed, arrowhead=vee, label=" nc"];
  n_AZUREParams -> n_ROOT__Minuit2__MnUserParameters [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_AZUREParams -> n_ParameterRecord [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_ParameterRecord -> n_ParamKindRow [style=dashed, arrowhead=vee];
  n_AZURECalc -> n_ParamIndexMap [style=dotted, penwidth=1.6, arrowhead=empty];
  n_AZURECalc -> n_GradAccum [style=dotted, penwidth=1.6, arrowhead=empty];
  n_AZURECalcMCMC -> n_WorkingData [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_AZURECalcMCMC -> n_CompoundSystem [style=dashed, arrowhead=vee];
  n_AZURECalcMCMC -> n_WalkerLevels [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_AZURECalcMCMC -> n_StatePool [style=dashed, arrowhead=vee, label=" nc"];
  n_WalkerLevels -> n_LevelState [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_AZURECalcMCMC -> n_PosteriorSupport [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_PosteriorSupport -> n_ParameterLimitsManager [style=dotted, penwidth=1.6, arrowhead=empty];
  n_nu__Mcmc -> n_nu__Ensemble [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_nu__Ensemble -> n_nu__Walker [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_AZURECalc -> n_Objective [style=dashed, arrowhead=vee];
  n_FitterRow -> n_AZUREParams [style=dashed, arrowhead=vee, label=" nc"];
  n_FitterRow -> n_AZURECalc [style=dashed, arrowhead=vee, label=" nc"];
  n_FitterRow -> n_FitControl [style=dashed, arrowhead=vee];
  n_FitterRow -> n_FitResult [style=dotted, penwidth=1.6, arrowhead=empty];
  n_FitEvaluations -> n_AZURECalc [style=dashed, arrowhead=vee, label=" nc"];
  n_FitEvaluations -> n_EvaluationObserver [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_FitEvaluations -> n_FitControl [style=dashed, arrowhead=vee];
  n_FitEvaluations -> n_FitProgress [style=dotted, penwidth=1.6, arrowhead=empty];
  n_AZURECalc -> n_EvaluationObserver [style=dashed, arrowhead=vee];
  n_AZURECalcMCMC -> n_nu__Mcmc [style=dotted, penwidth=1.6, arrowhead=empty];
  n_AZURECalcMCMC -> n_Objective [style=dashed, arrowhead=vee];
  legend [shape=plaintext, fontsize=11, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="3" COLOR="#888888"><TR><TD COLSPAN="2"><B>Legend</B></TD></TR><TR><TD COLSPAN="2"><TABLE BORDER="1" CELLBORDER="1" CELLSPACING="2" CELLPADDING="2"><TR><TD>immutable after the set-up</TD></TR></TABLE></TD></TR><TR><TD COLSPAN="2"><TABLE BORDER="1" CELLBORDER="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="#d9d9d9"><TR><TD>written by every evaluation</TD></TR></TABLE></TD></TR><TR><TD COLSPAN="2"><TABLE BORDER="1" CELLBORDER="0" CELLPADDING="3" ><TR><TD>a run or session object</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><B>owns</B></TD><TD ALIGN="LEFT">solid line, diamond at the owner</TD></TR><TR><TD ALIGN="LEFT"><B>reads</B></TD><TD ALIGN="LEFT">dashed line; label nc: not const</TD></TR><TR><TD ALIGN="LEFT"><B>makes</B></TD><TD ALIGN="LEFT">dotted line, open head</TD></TR></TABLE>>];
}
