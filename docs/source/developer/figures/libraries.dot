digraph libraries {
  graph [rankdir=TB, fontname="Helvetica", fontsize=12, labelloc=t, label="Libraries and their link lines", nodesep=0.25, ranksep=0.45, newrank=true];
  node [fontname="Helvetica", fontsize=11, margin="0.08,0.04"];
  edge [fontname="Helvetica", fontsize=9];
  n_azure2_support [label=<<b>azure2_support</b><br/><font point-size="9">the environment switches and<br/>their one reader</font>>, shape=box, style="filled", fillcolor="white"];
  n_azure2_physics [label=<<b>azure2_physics</b><br/><font point-size="9">physics of the R-matrix:<br/>channels, Coulomb functions,<br/>level-parameter bases</font>>, shape=box, style="filled", fillcolor="white"];
  n_azure2_physics_transfer [label=<<b>azure2_physics_transfer</b><br/><font point-size="9">optical potentials, bound<br/>states, distorted waves, DWBA,<br/>THM vertex</font>>, shape=box, style="filled", fillcolor="white"];
  n_azure2_io [label=<<b>azure2_io</b><br/><font point-size="9">the project document, &lt;config&gt;<br/>keys, &lt;levels&gt; rows, record<br/>reader</font>>, shape=box, style="filled", fillcolor="white"];
  n_azure2_io_record [label=<<b>azure2_io_record</b><br/><font point-size="9">the plain record structs of<br/>format 3 (header only)</font>>, shape=box, style="filled", fillcolor="white"];
  n_azure2_stopping [label=<<b>azure2_stopping</b><br/><font point-size="9">stopping and straggling<br/>(SRIM-2013)</font>>, shape=box, style="filled", fillcolor="white"];
  n_azure2_experiment [label=<<b>azure2_experiment</b><br/><font point-size="9">the format-3 table: quantities,<br/>units, kernels, specs, frames</font>>, shape=box, style="filled", fillcolor="white"];
  n_azure2_experiment_reader [label=<<b>azure2_experiment_reader</b><br/><font point-size="9">reads a format-3 project:<br/>document to validated specs</font>>, shape=box, style="filled", fillcolor="white"];
  n_azure2_convert_specs [label=<<b>azure2_convert_specs</b><br/><font point-size="9">old lines as set-up specs (the<br/>converter&#x27;s adaptor)</font>>, shape=box, style="filled", fillcolor="white"];
  n_azure2_convert [label=<<b>azure2_convert</b><br/><font point-size="9">the converter of old projects to<br/>format 3</font>>, shape=box, style="filled", fillcolor="white"];
  n_numcmc [label=<<b>numcmc</b><br/><font point-size="9">the affine-invariant ensemble<br/>sampler</font>>, shape=box, style="filled", fillcolor="white"];
  n_AZURE2Core [label=<<b>AZURE2Core</b><br/><font point-size="9">the engine: set-up, evaluation,<br/>objective, fits, output</font>>, shape=box, style="filled", fillcolor="white"];
  n_AZUREAPI [label=<<b>AZUREAPI</b><br/><font point-size="9">the engine as a session object</font>>, shape=box, style="filled", fillcolor="white"];
  n_AZURE2 [label=<<b>AZURE2</b><br/><font point-size="9">the program (command line and<br/>menu)</font>>, shape=box, style="filled", fillcolor="white"];
  n__azure2 [label=<<b>_azure2</b><br/><font point-size="9">the Python module (pybind11)</font>>, shape=box, style="filled", fillcolor="white"];
  n_pyazr [label=<<b>pyazr</b><br/><font point-size="9">the Python package</font>>, shape=box, style="filled", fillcolor="white"];
  n_pyazr_ui [label=<<b>pyazr.ui</b><br/><font point-size="9">the web UI&#x27;s server and page</font>>, shape=box, style="filled", fillcolor="white"];
  n_azure2_physics_transfer -> n_azure2_physics [style=solid, arrowhead=normal];
  n_azure2_stopping -> n_azure2_physics [style=solid, arrowhead=normal];
  n_azure2_stopping -> n_azure2_support [style=solid, arrowhead=normal];
  n_azure2_experiment -> n_azure2_physics [style=solid, arrowhead=normal];
  n_azure2_experiment -> n_azure2_io_record [style=solid, arrowhead=normal];
  n_azure2_experiment_reader -> n_azure2_experiment [style=solid, arrowhead=normal];
  n_azure2_experiment_reader -> n_azure2_io [style=solid, arrowhead=normal];
  n_azure2_convert_specs -> n_azure2_experiment [style=solid, arrowhead=normal];
  n_azure2_convert -> n_azure2_io [style=solid, arrowhead=normal];
  n_azure2_convert -> n_azure2_experiment [style=solid, arrowhead=normal];
  n_azure2_convert -> n_azure2_experiment_reader [style=solid, arrowhead=normal];
  n_azure2_convert -> n_azure2_physics [style=solid, arrowhead=normal];
  n_azure2_convert -> n_azure2_convert_specs [style=solid, arrowhead=normal];
  n_AZURE2Core -> n_azure2_support [style=solid, arrowhead=normal];
  n_AZURE2Core -> n_azure2_physics [style=solid, arrowhead=normal];
  n_AZURE2Core -> n_azure2_physics_transfer [style=solid, arrowhead=normal];
  n_AZURE2Core -> n_azure2_stopping [style=solid, arrowhead=normal];
  n_AZURE2Core -> n_azure2_io [style=solid, arrowhead=normal];
  n_AZURE2Core -> n_azure2_experiment [style=solid, arrowhead=normal];
  n_AZURE2Core -> n_azure2_experiment_reader [style=solid, arrowhead=normal];
  n_AZURE2Core -> n_numcmc [style=solid, arrowhead=normal];
  n_AZUREAPI -> n_AZURE2Core [style=solid, arrowhead=normal];
  n_AZURE2 -> n_AZUREAPI [style=solid, arrowhead=normal];
  n_AZURE2 -> n_AZURE2Core [style=solid, arrowhead=normal];
  n_AZURE2 -> n_azure2_convert [style=solid, arrowhead=normal];
  n__azure2 -> n_AZUREAPI [style=solid, arrowhead=normal];
  n__azure2 -> n_azure2_convert [style=solid, arrowhead=normal];
  n_pyazr -> n__azure2 [style=solid, arrowhead=normal];
  n_pyazr_ui -> n_pyazr [style=solid, arrowhead=normal];
  subgraph cluster_legend {
    label="Legend"; fontsize=10; style=dashed; color="#888888";
    node [fontname="Helvetica", fontsize=9, width=0.2, height=0.2];
    lA [shape=plaintext, label="A"]; lB [shape=plaintext, label="B"];
    lA -> lB [style=solid, arrowhead=normal, label=" A links (or imports) B", fontsize=9, fontname="Helvetica"];
  }
}
