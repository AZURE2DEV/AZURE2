digraph setup {
  graph [rankdir=LR, fontname="Helvetica", fontsize=16, labelloc=t, label="Project and set-up", nodesep=0.18, ranksep=0.3, newrank=true];
  node [fontname="Helvetica", fontsize=14, margin="0.08,0.04"];
  edge [fontname="Helvetica", fontsize=12];
  n_azure2__io__Document [label=<<b>azure2::io::Document</b><br/><font point-size="12">the project file as<br/>lossless lines and<br/>sections</font>>, shape=box, peripheries=2, style="filled", fillcolor="white"];
  n_azure2__io__LevelSection [label=<<b>azure2::io::LevelSection</b><br/><font point-size="12">the &lt;levels&gt; rows as<br/>read</font>>, shape=box, peripheries=2, style="filled", fillcolor="white"];
  n_azure2__experiment__Format3Project [label=<<b>azure2::experiment::Format3Project</b><br/><font point-size="12">the project read once:<br/>diagnostics, level<br/>tables, specs</font>>, shape=box, peripheries=2, style="filled", fillcolor="white"];
  n_azure2__experiment__BuiltProject [label=<<b>azure2::experiment::BuiltProject</b><br/><font point-size="12">what Schema::Build<br/>makes of the records</font>>, shape=box, peripheries=2, style="filled", fillcolor="white"];
  n_azure2__experiment__DatasetSpec [label=<<b>azure2::experiment::DatasetSpec</b><br/><font point-size="12">one data set as built:<br/>observable, pairs,<br/>nuisances</font>>, shape=box, peripheries=2, style="filled", fillcolor="white"];
  n_Config [label=<<b>Config</b><br/><font point-size="12">the run: options,<br/>paths, the project<br/>read, scratch</font>>, shape=box, style="filled", fillcolor="white"];
  n_CNuc [label=<<b>CNuc</b><br/><font point-size="12">compound nuclei: pairs<br/>and J groups (read-<br/>only after set-up),<br/>levels at the vector</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_PPair [label=<<b>PPair</b><br/><font point-size="12">a particle pair:<br/>masses, spins, radius,<br/>key</font>>, shape=box, peripheries=2, style="filled", fillcolor="white"];
  n_JGroup [label=<<b>JGroup</b><br/><font point-size="12">one J^pi group: its<br/>channels and levels</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_AChannel [label=<<b>AChannel</b><br/><font point-size="12">a channel (pair, l, s)<br/>with its boundary<br/>value</font>>, shape=box, peripheries=2, style="filled", fillcolor="white"];
  n_ALevel [label=<<b>ALevel</b><br/><font point-size="12">a level: E and gamma<br/>at the vector, flags</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_CNucSystem [label=<<b>CNucSystem</b><br/><font point-size="12">the physics System of<br/>a CNuc and its index<br/>map</font>>, shape=box, peripheries=2, style="filled", fillcolor="white"];
  n_azure2__physics__System [label=<<b>azure2::physics::System</b><br/><font point-size="12">partitions, channels<br/>and J^pi blocks</font>>, shape=box, peripheries=2, style="filled", fillcolor="white"];
  n_azure2__PathwayTable [label=<<b>azure2::PathwayTable</b><br/><font point-size="12">reaction pathways and<br/>interference terms</font>>, shape=box, peripheries=2, style="filled", fillcolor="white"];
  n_DataSet [label=<<b>DataSet</b><br/><font point-size="12">the data as set up:<br/>segments, effects,<br/>meshes</font>>, shape=box, peripheries=2, style="filled", fillcolor="white"];
  n_AbundanceSamples [label=<<b>AbundanceSamples</b><br/><font point-size="12">the targets&#x27; isotopic<br/>abundances: samples,<br/>priors; the abundance<br/>block of the vectors</font>>, shape=box, peripheries=2, style="filled", fillcolor="white"];
  n_Segment [label=<<b>Segment</b><br/><font point-size="12">one data set:<br/>measurement, settings,<br/>terms</font>>, shape=box, peripheries=2, style="filled", fillcolor="white"];
  n_TargetEffect [label=<<b>TargetEffect</b><br/><font point-size="12">a target, beam or<br/>detector effect and<br/>its kernels</font>>, shape=box, peripheries=2, style="filled", fillcolor="white"];
  n_WorkingCopy [label=<<b>WorkingCopy</b><br/><font point-size="12">what an evaluation<br/>changes; builds the<br/>DataSet</font>>, shape=box, style="rounded,filled", fillcolor="#d9d9d9"];
  n_Config -> n_azure2__io__Document [style=dotted, penwidth=1.6, arrowhead=empty];
  n_Config -> n_azure2__experiment__Format3Project [style=dotted, penwidth=1.6, arrowhead=empty];
  n_azure2__experiment__Format3Project -> n_azure2__io__LevelSection [style=dashed, arrowhead=vee];
  n_azure2__experiment__Format3Project -> n_azure2__experiment__BuiltProject [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_azure2__experiment__BuiltProject -> n_azure2__experiment__DatasetSpec [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_CNuc -> n_azure2__io__LevelSection [style=dashed, arrowhead=vee];
  n_CNuc -> n_PPair [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_CNuc -> n_JGroup [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_JGroup -> n_AChannel [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_JGroup -> n_ALevel [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_CNuc -> n_CNucSystem [style=dashed, arrowhead=vee];
  n_CNucSystem -> n_azure2__physics__System [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_CNuc -> n_azure2__PathwayTable [style=dashed, arrowhead=vee];
  n_WorkingCopy -> n_azure2__experiment__DatasetSpec [style=dashed, arrowhead=vee];
  n_WorkingCopy -> n_CNuc [style=dashed, arrowhead=vee, label=" nc"];
  n_WorkingCopy -> n_DataSet [style=dotted, penwidth=1.6, arrowhead=empty];
  n_WorkingCopy -> n_DataSet [style=dashed, arrowhead=vee];
  n_DataSet -> n_Segment [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_DataSet -> n_TargetEffect [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  n_DataSet -> n_AbundanceSamples [style=solid, dir=both, arrowtail=diamond, arrowhead=normal];
  legend [shape=plaintext, fontsize=11, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="3" COLOR="#888888"><TR><TD COLSPAN="2"><B>Legend</B></TD></TR><TR><TD COLSPAN="2"><TABLE BORDER="1" CELLBORDER="1" CELLSPACING="2" CELLPADDING="2"><TR><TD>immutable after the set-up</TD></TR></TABLE></TD></TR><TR><TD COLSPAN="2"><TABLE BORDER="1" CELLBORDER="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="#d9d9d9"><TR><TD>written by every evaluation</TD></TR></TABLE></TD></TR><TR><TD COLSPAN="2"><TABLE BORDER="1" CELLBORDER="0" CELLPADDING="3" ><TR><TD>a run or session object</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><B>owns</B></TD><TD ALIGN="LEFT">solid line, diamond at the owner</TD></TR><TR><TD ALIGN="LEFT"><B>reads</B></TD><TD ALIGN="LEFT">dashed line; label nc: not const</TD></TR><TR><TD ALIGN="LEFT"><B>makes</B></TD><TD ALIGN="LEFT">dotted line, open head</TD></TR></TABLE>>];
}
