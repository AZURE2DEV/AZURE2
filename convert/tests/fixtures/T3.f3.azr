<data>
# <segmentsData> line 1
dataset aa_cm050
    reaction       4He(a,a)4He
    quantity       dsigma_domega
    unit           b/sr
    file           data/aa_cm050.dat
    columns        E_lab[MeV] theta_cm[deg] value error
    energy_window  0.999999 8.000001 MeV
    angle_window   50 50 deg
    norm           1 fixed

# <segmentsData> line 2
dataset aa_cm090
    reaction       4He(a,a)4He
    quantity       dsigma_domega
    unit           b/sr
    file           data/aa_cm090.dat
    columns        E_lab[MeV] theta_cm[deg] value error
    energy_window  0.999999 8.000001 MeV
    angle_window   90 90 deg
    norm           1 fixed

# <segmentsData> line 3
dataset aa_phase_d
    reaction       4He(a,a)4He
    quantity       phase_shift
    unit           deg
    J              2
    l              2
    s              0
    file           data/aa_phase_d.dat
    columns        E_lab[MeV] _ value error
    energy_window  1.749999 7.000001 MeV
    norm           1 fixed

# <segmentsData> line 4
dataset beta_alpha
    reaction       8Li(b-,a)4He
    quantity       beta_delayed_spectrum
    unit           arbitrary
    file           data/beta_alpha.dat
    columns        E_decay[MeV] _ value error
    energy_window  0.399999 6.000001 MeV
    norm           1 fixed

# <segmentsData> line 5
dataset p7li_pp_lab150
    reaction       7Li(p,p)7Li
    quantity       dsigma_domega
    unit           b/sr
    file           data/p7li_pp_lab150.dat
    columns        E_lab[MeV] theta_lab[deg] value error
    energy_window  0.299999 2.400001 MeV
    angle_window   150 150 deg
    norm           1 fixed

# <segmentsData> line 6
dataset p7li_pn
    reaction       7Li(p,n)7Be
    quantity       sigma
    unit           b
    file           data/p7li_pn.dat
    columns        E_lab[MeV] _ value error
    energy_window  1.899999 2.400001 MeV
    norm           1 fixed

# <segmentsData> line 7
dataset p7li_pa
    reaction       7Li(p,a)4He
    quantity       sigma
    unit           b
    file           data/p7li_pa.dat
    columns        E_lab[MeV] _ value error
    energy_window  0.299999 2.400001 MeV
    norm           1 fixed

# <segmentsData> line 8
dataset n7be_total
    reaction       7Be(n,n)7Be
    quantity       sigma_total
    unit           b
    file           data/n7be_total.dat
    columns        E_lab[MeV] _ value error
    energy_window  0.009999 0.400001 MeV
    norm           1 fixed

# <segmentsData> line 9
dataset n7be_np
    reaction       7Be(n,p)7Li
    quantity       sigma
    unit           b
    file           data/n7be_np.dat
    columns        E_lab[MeV] _ value error
    energy_window  0.009999 0.400001 MeV
    norm           1 fixed
</data>
