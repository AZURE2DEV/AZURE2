# <segmentsData> line 1
dataset artemov
    reaction       12C(p,g)13N
    quantity       yield
    # CONVERTED: a thick target (density 0): the old engine compared the numbers as reactions per incident particle (yield in 1/particle)
    unit           1/particle
    file           data/artemov.dat
    columns        E_lab[MeV] _ value error
    energy_window  0 5 MeV
    norm           1 fixed
    target         tgt_targetInt2
    quadrature     points 10 width_multiplier 20 per_width 50

