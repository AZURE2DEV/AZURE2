<extrapolations>
</extrapolations>
<targets>
# <targetInt> line 1
target tgt_s01_int_thin
    kind           layer
    active         15N
    areal_density  5e17 atoms/cm2 fixed
    stopping       formula "a0*x^a1" a0=1.6e-20 a1=-0.45 MeV*cm2/atom
    straggling     bohr

# <targetInt> line 1
beam beam_s01_int_thin
    # CONVERTED: a Gaussian convolution is written as the beam's energy spread (the kernel is the same; the old line does not say whether it was a detector resolution)
    spread         0.001 MeV lab

# <targetInt> line 2
beam beam_targetInt2
    # CONVERTED: a Gaussian convolution is written as the beam's energy spread (the kernel is the same; the old line does not say whether it was a detector resolution)
    spread         0.002 MeV lab

# <targetInt> line 2
detector det_targetInt2
    attenuation    1 0.995 0.98 0.96 0.93

# <targetInt> line 3
target tgt_s04_thick
    kind           infinite
    active         15N
    stopping       formula "a0*x^a1" a0=1.6e-20 a1=-0.45 MeV*cm2/atom
    straggling     none

# <targetInt> line 4
target tgt_s05_implanted
    kind           layer
    active         15N
    areal_density  2e+17 atoms/cm2 fit prior 2e+17 10% grid_max 3e+17
    stopping       formula "a0*x^a1" a0=6.0e-20 a1=-0.30 MeV*cm2/atom
    straggling     coefficient 0.6 keV^1/2 cm

# <targetInt> line 4
beam beam_s05_implanted
    # CONVERTED: a Gaussian convolution is written as the beam's energy spread (the kernel is the same; the old line does not say whether it was a detector resolution)
    spread         0.0008 MeV lab

# <targetInt> line 5
target tgt_s06_gas
    kind           layer
    active         15N
    areal_density  1e18 atoms/cm2 fixed
    stopping       formula "a0*x^a1" a0=0.9e-20 a1=-0.50 MeV*cm2/atom
    straggling     none
    doppler        free_gas 300 K fixed

# <targetInt> line 5
beam beam_s06_gas
    # CONVERTED: a Gaussian convolution is written as the beam's energy spread (the kernel is the same; the old line does not say whether it was a detector resolution)
    spread         formula "a0*x" a0=0.004 MeV lab

# <targetInt> line 6
beam beam_s07_profile
    profile        skewed_gaussian xi 0.34 MeV omega 0.035 MeV alpha 1.5 weight 1.0
    truncation     0
    detailed_balance no

# <targetInt> line 6
detector det_s07_profile
    energy_resolution 0.004 MeV lab

# <targetInt> line 8
beam beam_LC09
    # CONVERTED: a Gaussian convolution is written as the beam's energy spread (the kernel is the same; the old line does not say whether it was a detector resolution)
    spread         0.021344 MeV lab

# <abundances> sample natN
target natN
    kind           none
    isotope        15N 0.0037 fit prior 0.0037 0.0002
    isotope_sum    none
</targets>
<parameterSettings>
</parameterSettings>
<thm>
# La Cognata et al. 2009: 2H(15N,a12C)n at 60 MeV; two HOES runs share one profiled scale
experiment[LC09] beam=15N target=d spectator=n Ebeam=60
</thm>
