<data>
# <segmentsData> line 1
dataset thm_lc2010_hoes_authbkg
    reaction       18O(p,a)15N
    quantity       sigma
    unit           arbitrary
    file           data/thm_lc2010_hoes_authbkg.dat
    columns        E_lab[MeV] _ value error
    energy_window  0.533369 0.945114 MeV
    norm           profiled
    beam           beam_thm_lc2010_hoes_authbkg
    quadrature     points 50 width_multiplier 5 per_width 50
    thm            LC10

# <segmentsData> line 2
dataset mak78
    reaction       18O(p,a)15N
    quantity       sigma
    unit           b
    file           data/mak78.dat
    columns        E_lab[MeV] _ value error
    energy_window  0.000000 2.000000 MeV
    norm           0.9699240041450711 fit prior 1 5%

